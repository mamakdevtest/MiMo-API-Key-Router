# Required only while creating a new database; remove after first successful start.
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password

# Use a stable, secret gateway key for clients. It is stored as a hash on first boot.
GATEWAY_KEY=replace-with-a-long-random-gateway-key

# Runtime
NODE_ENV=production
HOST=0.0.0.0
PORT=4000
APP_NAME=AI Provider Router
LOG_LEVEL=info

# Local SQLite database. Docker Compose overrides this to its persistent /data volume.
DATABASE_URL=file:./data/mimo-router.sqlite

# Required secrets: at least 32 characters each. Keep these stable after first boot.
APP_ENCRYPTION_KEY=replace-with-a-random-32-plus-character-encryption-key
SESSION_SECRET=replace-with-a-random-32-plus-character-session-secret

# Reverse-proxy and session settings.
TRUST_PROXY=true
COOKIE_SECURE=true
SESSION_MAX_AGE_SECONDS=86400

# Leave false unless providers are intentionally hosted on a private network.
ALLOW_PRIVATE_PROVIDER_URLS=false

# Required on first boot: admin dashboard password
INITIAL_ADMIN_PASSWORD=change-me

# Node environment
NODE_ENV=production

# Server port (default 4000)
PORT=4000

# Application name (shown in UI and health endpoint)
APP_NAME=AI Provider Router

# SQLite database path (persistent volume in Docker)
DATABASE_URL=file:/data/mimo-router.sqlite

# Trust X-Forwarded-For from reverse proxy (Coolify)
TRUST_PROXY=true

# Use secure cookies (set true when HTTPS is terminated at Coolify)
COOKIE_SECURE=true

# Encryption key for API keys (32+ chars, defaults to fallback)
# APP_ENCRYPTION_KEY=your-secret-encryption-key-at-least-32-chars

# Gateway key (set via env or generated on first boot)
# GATEWAY_KEY=mimo_your_gateway_key_here

# Maximum upstream attempts per gateway request
# MAX_UPSTREAM_ATTEMPTS=10

# Legacy MiMo configuration (used by default mimo provider)
# MIMO_OPENAI_BASE_URL=https://api.xiaomimimo.com/v1
# MIMO_ANTHROPIC_BASE_URL=https://api.xiaomimimo.com/anthropic
# MIMO_AUTH_HEADER=Authorization
# MIMO_AUTH_PREFIX=Bearer

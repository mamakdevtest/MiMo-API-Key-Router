# Required on first boot: admin dashboard password
INITIAL_ADMIN_PASSWORD=change-me

# Node environment
NODE_ENV=production

# Server port (default 4000)
PORT=4000

# SQLite database path (persistent volume in Docker)
DATABASE_URL=file:/data/mimo-router.sqlite

# Trust X-Forwarded-For from reverse proxy (Coolify)
TRUST_PROXY=true

# Use secure cookies (set true when HTTPS is terminated at Coolify)
COOKIE_SECURE=true
